    <string name="app_name">Handy</string>

    <!-- Foreground services -->
    <string name="assistant_service_channel_name">Handy Assistant</string>
    <string name="assistant_service_channel_description">Keeps the floating widget active and the microphone ready for push-to-talk.</string>
    <string name="assistant_service_notification_title">Handy is ready</string>
    <string name="assistant_service_notification_text">Tap the widget to chat. Long-press to speak.</string>

