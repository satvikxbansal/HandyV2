<?xml version="1.0" encoding="utf-8"?>
<!--
  Handy's AccessibilityService configuration. The flags below satisfy the
  guardrails ("Accessibility service configuration") — without them,
  getWindows(), viewIdResourceName, and takeScreenshot degrade silently.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewFocused|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagReportViewIds|flagRetrieveInteractiveWindows|flagRequestTouchExplorationMode|flagIncludeNotImportantViews"
    android:canRequestFilterKeyEvents="false"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_label" />
