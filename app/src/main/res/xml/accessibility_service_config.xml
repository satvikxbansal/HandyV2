<?xml version="1.0" encoding="utf-8"?>
<!--
  Handy's AccessibilityService configuration.

  Flags are intentionally minimal — see DL-004:

    flagReportViewIds             needed for the semantic pointer
                                  resolver (matches viewId suffixes).
    flagRetrieveInteractiveWindows needed for getWindows() on API 30+
                                   and for takeScreenshotOfWindow on
                                   API 34+.
    flagIncludeNotImportantViews  lets us read labels on Views that
                                   mark themselves not-important-for-a11y
                                   (some ad-hoc UI in 3p apps does).

  `canPerformGestures` is declared so Android permits tap-for-me after
  the user accepts the separate action disclosure. Gesture execution is
  still fail-closed in code until that versioned consent plus the
  Tap-for-me toggle and per-action sheet approval are present.

  Explicitly NOT set:
    flagRequestTouchExplorationMode - this is for TalkBack-style
      services that steal touch input to drive a screen reader.
      Handy does NOT want that behaviour; setting it makes Android
      display its Accessibility-shortcut bubble on top of the app.
    flagRequestFilterKeyEvents - pointless without
      canRequestFilterKeyEvents="true" (we filter no keys).
    flagRequestAccessibilityButton - we have no use for the system
      a11y button; requesting it forces the bubble.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged|typeViewFocused|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="false"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_label" />
