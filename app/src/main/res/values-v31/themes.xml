<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Handy.Splash" parent="Theme.Handy">
        <item name="android:windowBackground">@color/handy_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/handy_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowSplashScreenBackground">@color/handy_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">1600</item>
        <item name="postSplashScreenTheme">@style/Theme.Handy.Splash</item>
    </style>
</resources>
